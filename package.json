{
  "name": "datafund",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -n enclave,server,web \"npm:dev:enclave\" \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "setup:dao": "tsx scripts/create-dao.ts",
    "typecheck": "tsc --noEmit",
    "dev:enclave": "ENCLAVE_DEV=true tsx watch enclave/index.ts",
    "start:enclave": "tsx enclave/index.ts",
    "start:server": "tsx server/index.ts",
    "selftest": "ENCLAVE_DEV=true ENCLAVE_DATA_DIR=data/selftest tsx scripts/selftest.ts",
    "examples": "tsx scripts/make-examples.ts",
    "enclave:approve": "tsx scripts/approve-enclave.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "near-cli-rs": "^0.31.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.7"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@hono/node-server": "^2.1.6",
    "@near-wallet-selector/core": "^10.1.4",
    "@near-wallet-selector/meteor-wallet": "^10.1.4",
    "@near-wallet-selector/modal-ui": "^10.1.4",
    "@near-wallet-selector/my-near-wallet": "^10.1.4",
    "@noble/curves": "^1.8.1",
    "@noble/hashes": "^1.8.0",
    "@phala/dstack-sdk": "^0.5.8",
    "buffer": "^6.0.3",
    "hono": "^4.13.17",
    "lucide-react": "^1.72.0",
    "near-api-js": "^6.5.1",
    "openai": "^7.55.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  }
}
