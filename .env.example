# Network + DAO (created with `npm run setup:dao`)
NEAR_NETWORK=testnet
# RPC nodes are used in round-robin with failover. Defaults to the public keyless providers listed at
# https://docs.near.org/api/rpc/providers. Set a comma-separated list to override.
# NEAR_RPC_URLS=https://test.rpc.fastnear.com,https://near-testnet.drpc.org,https://testnet-rpc.intea.rs,https://api.zan.top/near-testnet
DAO_ID=datafund-41bbcc.sputnik-v2.testnet

# Verifier bot account. Its key is read from ~/.near-credentials/<network>/<account>.json
# unless VERIFIER_PRIVATE_KEY (ed25519:...) is set.
VERIFIER_ACCOUNT=datafund-verifier-41bbcc.testnet
# VERIFIER_PRIVATE_KEY=

# NEAR AI Cloud (https://cloud.near.ai). Without a key the verifier runs structural checks only.
NEAR_AI_API_KEY=
NEAR_AI_MODEL=z-ai/glm-5.3-flash

# Verifier behaviour
MIN_SCORE=70
MIN_AGREEMENT=0.8
AUTO_VOTE=true
PORT=8787
PUBLIC_URL=http://localhost:8787
