# Network and DAO (created with `npm run setup:dao`)
NEAR_NETWORK=testnet
# RPC nodes are used in round-robin with failover. Defaults to the public keyless providers listed at
# https://docs.near.org/api/rpc/providers. Set a comma-separated list to override. The enclave needs two or more,
# because it only releases a dataset key once two providers agree the payout was approved.
# NEAR_RPC_URLS=https://test.rpc.fastnear.com,https://near-testnet.drpc.org,https://testnet-rpc.intea.rs,https://api.zan.top/near-testnet
DAO_ID=datafund-41bbcc.sputnik-v2.testnet

# ---------- Public server (server/) ----------
# It holds no keys and no datasets. It reads the chain, serves the UI and relays to the enclave.
PORT=8787
PUBLIC_URL=http://localhost:8787
ENCLAVE_URL=http://localhost:8788

# Scale to zero (optional). The server shuts the enclave CVM down after IDLE_MINUTES without work and starts it
# again when a payout claim, review deadline, key release or browser request needs it. Waking takes about a minute.
# Create the API key in the Phala dashboard. PHALA_CVM_ID takes the app id with an app_ prefix, the UUID or the name.
# Never stop the CVM by deleting it. Its keys come from its app id, and a new CVM means new keys and a new DAO vote.
# PHALA_CLOUD_API_KEY=
# PHALA_CVM_ID=app_<app id>
# IDLE_MINUTES=10

# ---------- Verifier enclave (enclave/) ----------
# In a Phala CVM, set these as encrypted env vars. Its NEAR key and seal key come from the dstack KMS.
ENCLAVE_PORT=8788
# Local runs without a TEE. Keys then come from a plain file in ENCLAVE_DATA_DIR. Never use this in production.
# ENCLAVE_DEV=true
# ENCLAVE_DATA_DIR=data/enclave

# NEAR AI Cloud (https://cloud.near.ai). Without a key the enclave runs structural checks only.
NEAR_AI_API_KEY=
NEAR_AI_MODEL=z-ai/glm-5.3-flash

# Pinata (https://app.pinata.cloud). Lets contributors upload encrypted files to IPFS and lets the enclave pin them.
# Without it contributors host the encrypted file themselves and paste its link.
PINATA_JWT=
# Your Pinata gateway domain, tried first when fetching a CID (for example example.mypinata.cloud).
PINATA_GATEWAY=

# Verifier behaviour
MIN_SCORE=70
AUTO_VOTE=true
# Files up to FULL_SCAN_ROWS rows get every row redone by the AI. Bigger files get SAMPLE_ROWS random rows.
FULL_SCAN_ROWS=2000
SAMPLE_ROWS=500
MAX_DATASET_MB=10
